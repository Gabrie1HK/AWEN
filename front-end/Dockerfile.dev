# Dockerfile.dev - Desarrollo con hot-reload (Vite)
FROM node:22-alpine

WORKDIR /app

# Instalar dependencias (cache layer)
COPY package*.json ./
RUN npm ci

# El código se monta como volumen en docker-compose
# El comando se ejecuta desde docker-compose.yml con --host 0.0.0.0

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]