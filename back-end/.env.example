# Configuración de desarrollo local
# Copia este archivo a .env y ajusta los valores

# Clave secreta para JWT (mínimo 32 caracteres)
# Generar con: openssl rand -base64 32
AWEN_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long

# URL de conexión a PostgreSQL
# Formato: postgresql+psycopg://usuario:password@host:puerto/base_datos
AWEN_DATABASE_URL=postgresql+psycopg://awen:awen@localhost:5432/awen

# Orígenes permitidos para CORS (formato JSON array)
AWEN_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Directorio para archivos subidos
AWEN_UPLOAD_DIR=./uploads

# Configuración de almacenamiento (opcional - solo para producción con Vercel Blob)
# AWEN_STORAGE_PROVIDER=vercel-blob
# AWEN_BLOB_READ_WRITE_TOKEN=vercel_blob_token_aqui
# AWEN_STORAGE_BUCKET=awen-dev